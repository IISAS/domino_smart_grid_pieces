{
    "SolarGISDataGeneratorPiece": {
        "name": "SolarGISDataGeneratorPiece",
        "dependency": {
            "dockerfile": null,
            "requirements_file": "requirements_1.txt"
        },
        "tags": [
            "SolarGIS",
            "SyntheticData",
            "Generator"
        ],
        "style": {
            "node_label": "SolarGIS Data Generator",
            "node_type": "default",
            "node_style": {
                "backgroundColor": "#ebebeb"
            },
            "useIcon": true,
            "icon_class_name": "fa-solid:bolt",
            "iconStyle": {
                "cursor": "pointer"
            }
        },
        "description": "Generate synthetic SolarGIS solar radiation data (global horizontal irradiation, direct normal irradiation, diffuse horizontal irradiation) in batch or realtime-like mode.",
        "container_resources": {
            "requests": {
                "cpu": 100,
                "memory": 128
            },
            "limits": {
                "cpu": 500,
                "memory": 512
            }
        },
        "input_schema": {
            "additionalProperties": true,
            "properties": {
                "latitude": {
                    "default": 48.15,
                    "description": "Location latitude in decimal degrees (e.g. 48.15 for Bratislava).",
                    "title": "Latitude",
                    "type": "number"
                },
                "longitude": {
                    "default": 17.11,
                    "description": "Location longitude in decimal degrees (e.g. 17.11 for Bratislava).",
                    "title": "Longitude",
                    "type": "number"
                },
                "start_date": {
                    "default": "2026-01-01",
                    "description": "First day of the requested period in YYYY-MM-DD format.",
                    "title": "Start Date",
                    "type": "string"
                },
                "end_date": {
                    "default": "2026-01-07",
                    "description": "Last day of the requested period in YYYY-MM-DD format.",
                    "title": "End Date",
                    "type": "string"
                },
                "pvout_peak_kw": {
                    "default": 5.2,
                    "description": "Installed peak power of the PV system used to estimate PVOUT.",
                    "title": "PV System Peak Power (kWp)",
                    "type": "number"
                },
                "panel_tilt": {
                    "default": 30.0,
                    "description": "Tilt of the PV panels in degrees from horizontal for GTI calculation.",
                    "title": "Panel Tilt (degrees)",
                    "type": "number"
                },
                "output_mode": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": "batch_sample",
                    "description": "One of: `batch_sample`, `realtime_stream`.",
                    "title": "Output Mode"
                },
                "output_format": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "One of: `json`, `csv`.",
                    "title": "Output Format"
                }
            },
            "title": "InputModel",
            "type": "object"
        },
        "output_schema": {
            "properties": {
                "file_path": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Dataset file path"
                },
                "target_column": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Suggested target column for the generated dataset (pass downstream via fromUpstream).",
                    "title": "Target column"
                }
            },
            "title": "OutputModel",
            "type": "object"
        },
        "secrets_schema": null,
        "source_url": "https://github.com/IISAS/domino_smart_grid_pieces/tree/main/pieces/SolarGISDataGeneratorPiece"
    }
}